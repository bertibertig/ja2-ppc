# Machine-specific settings for the build, emulator and hardware scripts.
# Copy to local.env (git-ignored) and fill in your own paths. Scripts under
# tools/ source local.env automatically; keep personal paths out of the repo.

# Retro68 toolchain root (contains bin/ and powerpc-apple-macos/).
RETRO68_TOOLCHAIN=/path/to/Retro68-build/toolchain

# Legally installed Jagged Alliance 2 (contains Ja2.ini and Data/).
JA2_DATA_DIR=/path/to/Jagged Alliance 2

# Emulator images, ROMs and working copies (several GB, never committed).
EMU_WORK_DIR=/path/to/VMs/ja2-emu
# Mac OS install CD image used by 'tools/os9-emu.sh install'.
EMU_INSTALL_CD=/path/to/Mac OS 9.2.2 Install CD.iso

# DingusPPC source checkout with a build in build/bin/.
DINGUS_ROOT=/path/to/dingusppc
